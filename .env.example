# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env — it is gitignored.

# --- Delivery: Telegram (needed from Phase 3) ---
# Create a bot with @BotFather, then message it once to obtain your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Summarizer: Claude (only if summarizer.provider = claude) ---
ANTHROPIC_API_KEY=

# --- Summarizer: GitHub Models (only if summarizer.provider = github_models) ---
# In GitHub Actions this is provided automatically (see daily-brief.yml's
# `permissions: models: read` block) — no secret to set there. Locally, use a
# personal access token with "models: read" permission if you want to test
# this provider outside CI.
GITHUB_TOKEN=

# --- State backend: Turso (used automatically in CI; local runs default to
# --- a local SQLite file and can ignore these) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional overrides (sensible defaults are used if unset) ---
# PERSONAL_BRIEF_CONFIG=config/sources.yaml
# PERSONAL_BRIEF_DATA_DIR=data
# PERSONAL_BRIEF_LOG_LEVEL=INFO
